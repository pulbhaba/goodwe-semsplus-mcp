GOODWE_REGION=au
GOODWE_USERNAME=your-semsplus-username
GOODWE_PASSWORD=your-semsplus-password
GOODWE_STATION_ID=your-station-id

# Optional: JSON array of device records, e.g. [{"sn":"...","deviceType":"INVERTER"}]
GOODWE_DEVICE_LIST=

# Optional request and MCP listener settings
REQUEST_TIMEOUT=30
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
